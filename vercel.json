{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.stringsight.com/:path*"
    },
    {
      "source": "/results",
      "destination": "/index.html"
    },
    {
      "source": "/:dataset",
      "destination": "/index.html"
    },
    {
      "source": "/:dataset/(.*)",
      "destination": "/index.html"
    }
  ]
}
