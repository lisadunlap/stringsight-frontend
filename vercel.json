{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.stringsight.com/:path*"
    },
    {
      "source": "/results",
      "destination": "/index.html"
    },
    {
      "source": "/:dataset",
      "destination": "/index.html"
    },
    {
      "source": "/:dataset/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/datasets.yaml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
