{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/results",
      "destination": "/index.html"
    },
    {
      "source": "/:dataset",
      "destination": "/index.html"
    },
    {
      "source": "/:dataset/(.*)",
      "destination": "/index.html"
    }
  ]
}
