# Backend API URL (optional)
# Leave empty or set to /api to use the proxy in development mode
# Set to your backend URL for production deployments
# VITE_BACKEND=http://localhost:8000

# Demo mode (optional)
# When set to 'true', limits backend operations (extraction, clustering, custom code) to first 100 rows
# Full dataset is still displayed in the UI, but expensive backend processing is limited
# This is useful for demo environments to prevent expensive operations on large datasets
# VITE_DEMO=true
# When enabled, limits backend operations to 100 rows and fixes models:
#   - Property Annotator: gpt-4.1-mini
#   - Embedding: openai/text-embedding-3-large
#   - Summarization & Matching: gpt-4.1-mini
#   - Group by: behavior_type
